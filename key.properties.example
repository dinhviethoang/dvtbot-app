# Android Keystore Signing Configuration Example
# Copy this file to `android/key.properties` and replace with your real keystore values.
# Do NOT commit your real `key.properties` or keystore files to version control!

storeFile=release.jks
storePassword=your_store_password_here
keyAlias=your_key_alias_here
keyPassword=your_key_password_here

# Optional: pkcs12 or jks (defaults to jks)
storeType=jks
